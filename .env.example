HOST=0.0.0.0
PORT=8787
# Default: ~/.cc-switch
# CC_SWITCH_DIR=/path/to/.cc-switch
# follow, or a provider ID from CC Switch (independent for each route)
CODEX_PROVIDER=follow
CLAUDE_PROVIDER=follow
# system | direct | http://127.0.0.1:7897
UPSTREAM_PROXY=system
# Wait for upstream response headers; no idle timeout after headers/upgrade.
UPSTREAM_HEADER_TIMEOUT_MS=120000
SHUTDOWN_GRACE_MS=10000
LOG_LEVEL=info
