{
  "name": "ai-gateway-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:runtime": "node --test test/runtime.test.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:runtime"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "miniflare": "5.20261118.0-beta",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "wrangler": "^4.165.0"
  }
}
